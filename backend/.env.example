# Environment
NODE_ENV=production

# Server Configuration
PORT=10000
# Comma-separated list of allowed origins (Vercel production + preview)
CORS_ORIGINS=https://your-app.vercel.app,https://your-app-git-branch-user.vercel.app
# Fallback single origin
FRONTEND_URL=https://your-app.vercel.app
# Public-facing backend URL — used to build OTA outbound iCal feed links returned to the frontend.
# Must be reachable by OTA platforms (Airbnb, Booking.com, VRBO) to import the calendar.
# Example (Render): https://pilloto-pms.onrender.com
# Example (custom domain): https://api.pilloto.com
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# Uploads Directory (Render Disk mount path)
UPLOADS_DIR=/uploads

# Database - MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pilloto_pms?retryWrites=true&w=majority

# JWT and Session
JWT_SECRET=change-me-strong-random-hex
JWT_EXPIRES_IN=7d
SESSION_SECRET=change-me-strong-random-hex

# Email Configuration (optional)
EMAIL_FROM=info@bananaaquapark.com
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USER=info@bananaaquapark.com
EMAIL_PASS=your-app-password
EMAIL_SECURE=false

# Amazon SES (replaces Microsoft Graph / SMTP)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
SES_FROM_ADDRESS=noreply@pilloto.com
# SES Configuration Set name (for bounce/complaint tracking via SNS)
SES_CONFIGURATION_SET=pilloto-transactional
# Shared secret for validating SNS webhook payloads (set any random string)
SES_WEBHOOK_SECRET=change-me-strong-random-hex

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Microsoft Graph (optional)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_UPN=# Environment
NODE_ENV=development

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# Uploads Directory (local development)
UPLOADS_DIR=./uploads

# Database
MONGODB_URI=mongodb://localhost:27017/pilloto_pms

# JWT Secret (change this in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (for contact forms and notifications)
EMAIL_FROM=noreply@bananaranch.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Cloudinary (for image uploads - optional)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe (for payments - optional)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ─── Multi-tenancy ─────────────────────────────────────────────────────────────
# Local development: set to the slug of the tenant you want to work with.
# In production this is inferred from the subdomain (e.g. hotel1.pilloto.com → slug=hotel1).
# Leave empty when running as the platform server (admin.pilloto.com).
TENANT_SLUG=

# Migration script — only needed when running migrate-to-multitenant.ts once
FIRST_TENANT_NAME=My Hotel
FIRST_TENANT_SLUG=myhotel
FIRST_TENANT_OWNER_EMAIL=owner@myhotel.com
SUPERADMIN_EMAIL=admin@pilloto.com
SUPERADMIN_PASSWORD=change-me-strong-password


RESEND_API_KEY=test_XXXXXXXXXXXXXXXX
RESEND_FROM_ADDRESS=yyyyyyyyyyyyyyy
RESEND_WEBHOOK_SECRET=yyyyyyyyyyyyyy

# ─── e-CF (electronic fiscal invoicing) — BillingSoft ──────────────────────────
# Pilloto is a *partner* Organization in BillingSoft: one API key acts for every company by naming
# its Organization in a header, so no company holds a credential of its own.
# Without BILLINGSOFT_PARTNER_API_KEY the app boots and e-CF is simply unavailable.
BILLINGSOFT_API_URL=https://api.billingsoft.net
BILLINGSOFT_PARTNER_API_KEY=
# Where companies upload their certificate and complete DGII's certification (links in the UI).
BILLINGSOFT_APP_URL=https://app.billingsoft.net
# BACKEND_PUBLIC_URL (above) is also the origin BillingSoft posts webhooks to: it must be https and public.
# Development/QA only, ignored in production: issue even when DGII has not certified the company.
# Those documents have no fiscal value.
# FISCAL_ALLOW_UNCERTIFIED=true
# FISCAL_WORKERS_DISABLED=true
# 32-byte (64 hex chars) key for AES-256-GCM encryption of each company's webhook signing secret.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED once any company activates e-CF. Keep this secret — do NOT commit to source control.
ECF_ENCRYPTION_KEY=

# ─── Subscription billing (what Pilloto charges its tenants) ──────────────────
# Last month's charge is generated for every tenant by itself in production, and emails them.
# Elsewhere it does not run unless BILLING_AUTORUN=true; BILLING_AUTORUN=false switches it off in
# production too. The e-CF is never scheduled: it is issued when a payment is recorded.
# BILLING_AUTORUN=true

# ─── Channel manager (Channex) — CHANNEX_ARCHITECTURE.md §5.3 ──────────────────
# The app boots without these; the channel manager is then unavailable.
CHANNEX_ENV=staging
# CHANNEX_BASE_URL=https://staging.channex.io   (defaults from CHANNEX_ENV)
CHANNEX_API_KEY=
# Signing secret from the platform console (Channel Manager → Create signing key)
CHANNEX_WEBHOOK_SECRET=
# Public URL Channex calls (a tunnel URL locally), e.g. https://<tunnel>/api/webhooks/channex
CHANNEX_WEBHOOK_URL=
# The OTAs offered to tenants are chosen in the platform console (Channel Manager → OTAs offered to tenants)
# CHANNEX_WORKERS_DISABLED=true
