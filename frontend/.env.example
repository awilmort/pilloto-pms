REACT_APP_CURRENCY_SYMBOL=RD$
REACT_APP_LOCALE=es-DO
# React app environment variables for production
# Vercel: set these in Project Settings → Environment Variables

# Base URL for API (Render service URL)
REACT_APP_API_URL=https://your-backend.onrender.com/api

# ─── Multi-tenancy ─────────────────────────────────────────────────────────────
# Local development: set to the slug of the tenant you want to work with.
# In production this is inferred from the subdomain (e.g. hotel1.pilloto.com → slug=hotel1).
# For the platform admin portal (admin.pilloto.com) leave this empty.
# Set to __superadmin__ to develop the platform portal locally.
REACT_APP_TENANT_SLUG=
